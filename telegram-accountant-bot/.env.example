# --- تنظیمات بات حسابیار ---
# این فایل را به .env کپی کنید و مقادیر را پر کنید.

# توکن بات تلگرام (از @BotFather بگیرید) — الزامی
BOT_TOKEN=

# --- Google Sheets (منبع اصلی داده) — الزامی ---
# کل محتوای JSON کلید سرویس‌اکانت، به‌صورت base64 (امن‌تر برای Variables).
# تولید:  base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
# (جایگزین: می‌توانید JSON خام را در GOOGLE_SERVICE_ACCOUNT_JSON بگذارید.)
# شناسه‌ی اسپردشیتِ *مرکزی* (رجیستری کاربرها/اشتراک‌ها/پرداخت‌ها).
# با ایمیل سرویس‌اکانت به‌عنوان Editor شیر شود.
GOOGLE_SHEET_ID=
# پوشه‌ی Drive که اسپردشیتِ اختصاصیِ هر کاربر داخلش ساخته می‌شود.
# مهم: سرویس‌اکانت به‌تنهایی کوتای Drive ندارد؛ یک پوشه با اکانت گوگلِ خودت
# بساز، آن را با ایمیل سرویس‌اکانت به‌عنوان Editor شیر کن، و شناسه‌اش (از URL)
# را اینجا بگذار. اگر خالی بماند ساختِ شیت ممکن است با خطای کوتا شکست بخورد.
DRIVE_PARENT_FOLDER_ID=

# واحد پول پیش‌فرض
DEFAULT_CURRENCY=تومان

# ساعت و دقیقه‌ی ارسال یادآوری روزانه‌ی سررسیدها (به وقت ایران، ۲۴ساعته)
REMINDER_HOUR=9
REMINDER_MINUTE=0
# چند روز قبل از سررسید هم پیشاپیش یادآوری شود (۰ = فقط روز سررسید و معوق‌ها)
REMINDER_LEAD_DAYS=2
# خلاصه‌ی خودکار شبانه‌ی فعالیت (فقط برای کاربرانِ فعالِ امروز) و ساعتِ ارسال
NIGHTLY_SUMMARY=true
NIGHTLY_SUMMARY_HOUR=21

# --- سرویس OCR اختیاری برای خواندن عکس رسید/فاکتور ---
# سازگار با API نوع OpenAI (chat/completions با ورودی تصویر).
# پیشنهاد: روی یک سرور خارج از ایران میزبانی کنید و آدرسش را اینجا بگذارید.
# اگر خالی بماند، خواندن عکس غیرفعال می‌شود ولی بقیه‌ی امکانات کار می‌کنند.
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=gpt-4o-mini

# --- استخراج هوشمند با LLM (اختیاری) ---
# اگر روشن باشد، به‌جای کلیدواژه از یک مدل زبانی برای تشخیص نوع/دسته و
# استخراج فروشنده/تاریخ/شماره فاکتور استفاده می‌شود. در صورت خطا خودکار به
# روش قاعده‌محور برمی‌گردد. اگر LLM_* خالی بماند از همان تنظیمات OCR استفاده می‌شود.
USE_LLM_PARSER=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- تبدیل گفتار به متن (ویس→متن) اختیاری ---
# سرویس سازگار با API نوع OpenAI (مسیر audio/transcriptions، مثل Whisper) که
# برای فارسی خوب کار می‌کند. اگر خالی بماند از همان OCR_* استفاده می‌شود؛ اگر
# آن هم نباشد ارسال ویس غیرفعال است (کاربر پیام «تایپ کنید» می‌گیرد).
# چون از داخل ایران محدود است، روی سرور خارج میزبانی/پراکسی کنید.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=fa

# --- اشتراک و پرداخت ---
# روش پرداخت اشتراک: card (کارت‌به‌کارت) یا zarinpal (درگاه آنلاین)
PAYMENT_METHOD=card
# مدت دوره‌ی آزمایشی رایگان برای کاربر جدید (روز)
TRIAL_DAYS=14

# روش کارت‌به‌کارت: شماره‌کارت و نام صاحب کارت.
CARD_NUMBER=
CARD_HOLDER=

# روش زرین‌پال: مرچنت‌آیدی و حالت تست.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
PAYMENT_CALLBACK_URL=

# --- سامانه‌ی مودیان (صورتحساب الکترونیکی) ---
# توجه: نسخه‌ی فعلی اسکلت است؛ ارسال واقعی به گواهی/کلید رسمی نیاز دارد.
# اگر MOADIAN_BASE_URL و MOADIAN_TOKEN خالی باشند، حالت آزمایشی (dry-run) فعال است.
MOADIAN_BASE_URL=
MOADIAN_TOKEN=
SELLER_TIN=
ECONOMIC_CODE=
VAT_RATE=0.10

# --- پشتیبان‌گیری ---
# پشتیبان هفتگی خودکار: کل اسپردشیت به‌صورت اکسل برای ادمین‌ها ارسال می‌شود.
BACKUP_WEEKLY=true

# --- نرخ دلار (نمای دلاریِ درآمد) ---
# اگر کانالی دارید که هر روز قیمت دلار را می‌گذارد، شناسه‌ی عددی‌اش را اینجا
# بگذارید و بات را ادمینِ آن کانال کنید تا نرخ خودکار ثبت شود (مثل -1001234567).
# خالی = فقط ثبت دستی با دستور /rate توسط مدیر.
RATE_CHANNEL_ID=

# نام کاربری بات (برای امضای پای فاکتور در سطح برنزی).
# خالی = هنگام اجرا خودکار از تلگرام گرفته می‌شود.
BOT_USERNAME=

# شناسه‌های عددی مدیران (با کاما جدا کنید).
# مدیران رسیدهای پرداخت را تأیید/رد می‌کنند و یادآوری‌ها را می‌بینند.
ADMIN_IDS=
